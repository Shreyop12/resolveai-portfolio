RESOLVEAI_ENVIRONMENT=development
RESOLVEAI_DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@postgres:5432/resolveai
RESOLVEAI_REDIS_URL=redis://redis:6379/0
RESOLVEAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESOLVEAI_OLLAMA_BASE_URL=http://host.docker.internal:11434
RESOLVEAI_OLLAMA_EMBEDDING_MODEL=embeddinggemma
RESOLVEAI_OLLAMA_CHAT_MODEL=qwen3:1.7b
# Local models can be slower than cloud models; background jobs may use this full window.
RESOLVEAI_OLLAMA_CHAT_TIMEOUT_SECONDS=300
RESOLVEAI_OLLAMA_TRIAGE_MODEL=qwen3:1.7b
RESOLVEAI_OLLAMA_REVIEWER_MODEL=qwen3:1.7b
RESOLVEAI_OLLAMA_KEEP_ALIVE=15m
RESOLVEAI_OLLAMA_DRAFT_MAX_OUTPUT_TOKENS=220
RESOLVEAI_OLLAMA_TRIAGE_MAX_OUTPUT_TOKENS=80
RESOLVEAI_OLLAMA_REVIEWER_MAX_OUTPUT_TOKENS=80
# Keep Ollama until you add an OpenRouter key. Then set DRAFT_PROVIDER=openrouter.
RESOLVEAI_DRAFT_PROVIDER=ollama
RESOLVEAI_AGENT_PROVIDER=ollama
RESOLVEAI_DRAFT_EVALUATION_EXECUTION_MODE=redis
RESOLVEAI_EMBEDDING_PROVIDER=ollama
RESOLVEAI_FASTEMBED_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
RESOLVEAI_OPENROUTER_API_KEY=
# Use a specific free model for repeatable experiments. The fallback is tried only
# when the primary model is temporarily unavailable, rate-limited, or times out.
RESOLVEAI_OPENROUTER_DRAFT_MODEL=openai/gpt-oss-20b:free
RESOLVEAI_OPENROUTER_FALLBACK_DRAFT_MODEL=nvidia/nemotron-nano-9b-v2:free
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai
POSTGRES_DB=resolveai
